# Quine Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source it before running quine:
#   source .env
#   quine "Hello"
#
# IMPORTANT: Every line must start with 'export' so that
# 'source .env' exports variables to child processes.

# ── Required (all four must be set) ──────────────────────
export QUINE_MODEL_ID=claude-sonnet-4-6
export QUINE_API_TYPE=anthropic
export QUINE_API_BASE=https://api.anthropic.com
export QUINE_API_KEY=sk-your-key-here

# ── Optional: Harness Label ────────────────────────────
# export QUINE_PROVIDER=anthropic     # Harness/profile label only; `quine` ignores this env

# ── Optional: Execution / Resource Limits ───────────────
# export QUINE_MAX_DEPTH=0            # Max recursion depth
# export QUINE_MAX_AGENTS=0           # Max registered agents; 0 = unlimited
# export QUINE_MAX_CONCURRENT=0       # Max concurrent inference slots; 0 = unlimited
# export QUINE_MAX_TURNS=0            # Max number of sh executions
# export QUINE_WALL_CLOCK_EXIT_SECONDS=0  # Self-exit deadline in seconds; 0 = disabled
# export QUINE_FORK_DEFAULT_TIMEOUT_SECONDS=0  # Max wall time for wait/race fork joins; 0 = disabled
# export QUINE_SH_DEFAULT_TIMEOUT_SECONDS=300  # Default sh timeout (seconds)
# export QUINE_SH_TIMEOUT_OVERRIDE_ENABLED=1   # 1 | 0; expose and accept per-call sh timeout override
# export QUINE_OUTPUT_TRUNCATE=20480  # Per-tool output byte cap
# export QUINE_STALL_THRESHOLD=5      # Escalation warning threshold for repeated same-goal turns

# ── Optional: Workspace / Backend Choice ────────────────
# export QUINE_WORKSPACE_ROOT=/abs/path/to/workspace
# export QUINE_WORKSPACE=/abs/path/to/workspace  # Writable scope within QUINE_WORKSPACE_ROOT
# export QUINE_WORKSPACE_BACKEND=direct  # direct on macOS/shared host-visible work; overlay is Linux-only
# export QUINE_WORKSPACE_OVERLAY_DRIVER=kernel  # kernel | fuse; overlay backend only
# export QUINE_WORKSPACE_REVISION_MODE=none  # direct only supports none; overlay defaults to restore
# export QUINE_RUNTIME_SURFACE_BACKEND=legacy  # legacy | fuse; fuse is Linux-only
# export QUINE_WORKSPACE_COMMIT_ON_SIGNAL=0  # 1 | 0; commit latest completed workspace revision on external signal shutdown
# export QUINE_WORKSPACE_BOOTSTRAP=          # Optional workspace-session bootstrap source for first init
# If workspace physics are enabled and QUINE_WORKSPACE_BACKEND is unset, runtime defaults to overlay.

# ── Optional: Capability / Disclosure / Governance ──────
# export QUINE_TURN_EXHAUSTION_POLICY=hard_fail   # only supported value when QUINE_MAX_TURNS>0
# export QUINE_FORK_ENABLED=1         # 1 | 0; schema + runtime gate for fork
# export QUINE_EXEC_ENABLED=1         # 1 | 0; schema + runtime gate for exec
# export QUINE_EXIT_ENABLED=1         # 1 | 0; schema + runtime gate for exit
# export QUINE_SPAWN_ENABLED=0        # 1 | 0; expose fresh Quine process spawning without parent context bootstrap
# export QUINE_VISION_ENABLED=1       # 1 | 0; schema + runtime gate for vision
# export QUINE_SH_INTERACTIVE_ENABLED=1  # 1 | 0; expose sh(interactive=true) prompt/schema surfaces
# export QUINE_IDLE_ENABLED=0         # 1 | 0; expose idle suspension tool
# export QUINE_ANCHOR_MEMORY=0        # 1 | 0; expose mark/unfold tools
# export QUINE_FORK_WORLD_ENABLED=0   # 1 | 0; expose child world/protection choices when workspace physics are enabled
# export QUINE_AGENTS_MD_ENABLED=0    # 1 | 0; project repo AGENTS.md into prompt fragments
# export QUINE_AGENTS_SKILLS_ENABLED=0  # 1 | 0; project generated SKILLS.md into prompt fragments
# export QUINE_SELF_SOURCE_CODE_ENABLED=0  # 1 | 0; project read-only source-code/ self surface
# export QUINE_PROMPT_METAPHOR=off    # off | thermodynamic
# export QUINE_PROMPT_SELF_MODEL=advanced   # advanced | basic
# export QUINE_PROMPT_RUNTIME_SURFACE=visible  # visible | hidden
# export QUINE_PROMPT_PERSONA=        # optional: coder | analyst | engineer | architect | explorer | steward | cartographer | gardener | witness | catalyst | skeptic
# export QUINE_PROMPT_CTL=1           # 1 | 0; hide/show ctl/inbox/signal bridge disclosure
# export QUINE_PROMPT_IMPL_DETAILS=0  # 1 | 0; reveal fd/exec/detach implementation physics
# export QUINE_PEER_DISCOVERY_ENABLED=0  # 1 | 0; expose local peer topology observations at safe points
# export QUINE_PEER_DISCOVERY_HEARTBEAT_INTERVAL_MS=5000 # stale peer lock scan cadence when peer discovery is enabled
# export QUINE_FS_MUTATION_TELEMETRY_ENABLED=1  # default; set 0 to suppress fs_mutations telemetry blocks/results
# export QUINE_FAIL_ON_IMPOSSIBLE=1   # mixed control: prompt posture + exit schema + runtime validation
# export QUINE_EMPTY_ASSISTANT_SUCCESS=0  # 1 | 0; treat empty assistant response after tool/workspace progress as success
# export QUINE_EPHEMERAL_BODY_ENABLED=0 # 1 | 0; unlink the launch-path executable after startup

# ── Optional: Runtime I/O + Shell ────────────────────────
# export QUINE_DATA_DIR=.quine/       # Runtime root for logs, jobs, tapes, and workspace state
# export QUINE_RETENTION_DIR=         # Retained evidence export surface (for example runs/<runid>/log)
# export QUINE_WORK_DIR=              # Startup shell cwd; defaults to current workspace or current pwd
# export QUINE_SHELL=/bin/sh          # Shell binary used for sh calls
# export QUINE_SH_NETWORK=host        # host | none
# export QUINE_CONFIG_DIR=            # Config directory for OAuth tokens; defaults to ~/.config/quine/
# export QUINE_SELF_REENTRY_MODE=executable_path  # Optional override for non-Linux fork/exec re-entry; default is self (Linux-only)

# ── Optional: Context / Reasoning ────────────────────────
# export QUINE_CONTEXT_WINDOW=128000  # Context window size in tokens
# export QUINE_MEMORY_WARN_TOKENS=8000   # Working-context warning threshold; default is derived from QUINE_CONTEXT_WINDOW
# export QUINE_MEMORY_DANGER_TOKENS=16000  # Working-context danger threshold; default is derived from QUINE_CONTEXT_WINDOW
# export QUINE_USER_AGENT=            # Optional custom User-Agent for API requests
# export QUINE_THINKING_BUDGET=high   # off | low | medium | high | xhigh; request-side reasoning budget
# export QUINE_MODEL_SERVICE_TIER=priority  # OpenAI Responses service tier: priority | fast | flex

# ── Optional: Escalation Tier ────────────────────────────
# export QUINE_SMART_MODEL_ID=
# export QUINE_SMART_API_TYPE=
# export QUINE_SMART_API_BASE=
# export QUINE_SMART_API_KEY=

# ── Example: Anthropic via Claude Code subscription OAuth ─
# Reuses Claude Code credentials when available. If no fresh token can be
# refreshed, Quine starts a browser OAuth flow. You can also export a
# `CLAUDE_CODE_OAUTH_TOKEN` generated by `claude setup-token`.
# export QUINE_PROVIDER=anthropic     # Harness label only
# export QUINE_MODEL_ID=claude-sonnet-4-6
# export QUINE_API_TYPE=anthropic
# export QUINE_API_BASE=https://api.anthropic.com
# export QUINE_API_KEY=claude-oauth

# ── Example: OpenAI Responses API with Codex OAuth ───────
# export QUINE_PROVIDER=openai        # Harness label only
# export QUINE_MODEL_ID=gpt-5.1-codex-mini
# export QUINE_API_TYPE=openai-responses
# export QUINE_API_BASE=https://chatgpt.com/backend-api/codex
# export QUINE_API_KEY=codex-oauth

# ── Example: Google Gemini 3.5 Flash via OpenAI compatibility ─
# export QUINE_PROVIDER=gemini
# export QUINE_MODEL_ID=gemini-3.5-flash
# export QUINE_API_TYPE=openai
# export QUINE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# export QUINE_API_KEY="${GEMINI_API_KEY:-${GOOGLE_GENERATIVE_AI_API_KEY:-}}"
# export QUINE_THINKING_BUDGET=low

# ── Example: GitHub Copilot OAuth with Claude Sonnet 4.6 ─
# export COPILOT_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
# export QUINE_PROVIDER=copilot       # Harness label only
# export QUINE_MODEL_ID=claude-sonnet-4.6
# export QUINE_API_TYPE=openai
# export QUINE_API_BASE=https://api.business.githubcopilot.com
# export QUINE_API_KEY=copilot-oauth
# export QUINE_THINKING_BUDGET=off
