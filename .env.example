# Quine Configuration
#
# GENERATED from internal/config/registry.go by `go run ./scripts/gen-env-docs`
# (renderer: internal/config/docgen.go). Do not edit by hand.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then source it before running quine:
#   source .env
#   quine "Hello"
#
# IMPORTANT: Every line must start with 'export' so that
# 'source .env' exports variables to child processes.

# ── Required (all four must be set) ──────────────────────
export QUINE_MODEL_ID=claude-sonnet-4-6
export QUINE_API_TYPE=anthropic
export QUINE_API_BASE=https://api.anthropic.com
export QUINE_API_KEY=sk-your-key-here

# ── Optional: Harness Label ──────────────────────────────
# export QUINE_PROVIDER=anthropic             # profile / harness label only; `quine` ignores this env

# ── Optional: Runtime Identity And Protocol ───────────────
# export QUINE_CONFIG_DIR=                         # OAuth token/config storage
# export QUINE_USER_AGENT=                         # HTTP header shaping
# export QUINE_THINKING_BUDGET=high                # request shaping (off | low | medium | high | xhigh)
# export QUINE_MODEL_SERVICE_TIER=                 # request shaping (priority | flex | fast)
# export QUINE_DEBUG_REQUEST_BODY_DIR=             # debug dump

# ── Optional: Workspace And Runtime-Surface Backends ──────
# export QUINE_WORKSPACE_ROOT=                     # managed workspace root
# export QUINE_WORKSPACE=                          # managed workspace scope; default derived from QUINE_WORKSPACE_ROOT
# export QUINE_WORKSPACE_BACKEND=                  # workspace backend (overlay | direct); default derived from QUINE_WORKSPACE_ROOT
# export QUINE_WORKSPACE_OVERLAY_DRIVER=           # overlay mount driver (kernel | fuse); default derived from QUINE_WORKSPACE_BACKEND
# export QUINE_WORKSPACE_REVISION_MODE=            # revision surface (none | restore); default derived from QUINE_WORKSPACE_BACKEND
# export QUINE_WORKSPACE_COMMIT_ON_SIGNAL=0        # signal shutdown workspace finalization (1 | 0)
# export QUINE_WORLD_ONE_PER_SHELL=0               # one-world-per-shell guard (1 | 0)

# ── Optional: Capability Exposure ─────────────────────────
# export QUINE_FORK_ENABLED=1                      # fork capability (1 | 0)
# export QUINE_FORK_WORLD_ENABLED=0                # child world / protection request surface (1 | 0)
# export QUINE_SPAWN_ENABLED=0                     # fresh spawn capability (1 | 0)
# export QUINE_EXEC_ENABLED=1                      # exec capability (1 | 0)
# export QUINE_EXIT_ENABLED=1                      # exit capability (1 | 0)
# export QUINE_VISION_ENABLED=0                    # vision capability (1 | 0)
# export QUINE_SH_INTERACTIVE_ENABLED=1            # sh(interactive=true) request surface (1 | 0)
# export QUINE_SH_STDIN_ENABLED=1                  # sh(stdin=...) request surface (1 | 0)
# export QUINE_SH_DETACH_ENABLED=1                 # sh(detach=true) request surface (1 | 0)
# export QUINE_IDLE_ENABLED=0                      # explicit suspension capability (1 | 0)
# export QUINE_ANCHOR_MEMORY=0                     # memory tools (1 | 0)
# export QUINE_ANCHOR_FOLD_ENABLED=1               # fold move on mark (1 | 0)
# export QUINE_ANCHOR_MARK_ENABLED=1               # mark crystallization tool (1 | 0)
# export QUINE_AGENTS_MD_ENABLED=0                 # project AGENTS.md context projection (1 | 0)
# export QUINE_AGENTS_SKILLS_ENABLED=0             # project SKILLS context projection (1 | 0)
# export QUINE_SELF_SOURCE_CODE_ENABLED=0          # source-code self surface (1 | 0)
# export QUINE_SELF_SOURCE_PROJECTION=none         # source-code self-surface projection shape (none | runtime | repo)
# export QUINE_PEER_DISCOVERY_ENABLED=0            # peer topology observation (1 | 0)
# export QUINE_PEER_DISCOVERY_HEARTBEAT_INTERVAL_MS=5000  # peer stale-lock heartbeat cadence

# ── Optional: Prompt Disclosure ───────────────────────────
# export QUINE_PROMPT_METAPHOR=off                 # framing overlay (off | thermodynamic)
# export QUINE_PROMPT_SELF_MODEL=advanced          # continuity / cognition disclosure (basic | advanced)
# export QUINE_PROMPT_RUNTIME_SURFACE=visible      # runtime-surface disclosure (visible | hidden)
# export QUINE_PROMPT_INSTRUCTION_SURFACE=standard  # instruction-surface disclosure (standard | minimal | minimal_autonomy | minimal_existence)
# export QUINE_INITIAL_USER_MESSAGE=               # synthetic TTY initial user message
# export QUINE_PROMPT_PERSONA=                     # role-stance overlay (coder | analyst | engineer | architect | explorer | steward | cartographer | gardener | witness | catalyst | skeptic)
# export QUINE_PROMPT_CTL=1                        # peer-control disclosure (1 | 0)
# export QUINE_PROMPT_IMPL_DETAILS=0               # implementation-physics disclosure (1 | 0)
# export QUINE_NO_MISSION_AUTONOMY=off             # missionless opening posture (off | autonomy | sensing | full)
# export QUINE_PROMPT_BUDGET_VISIBILITY=visible    # budget disclosure (visible | hidden)

# ── Optional: Runtime Evidence And Telemetry ──────────────
# export QUINE_FS_MUTATION_TELEMETRY_ENABLED=1     # filesystem mutation telemetry (1 | 0)

# ── Optional: Response Governance And Execution Envelope ──
# export QUINE_FAIL_ON_IMPOSSIBLE=1                # impossibility posture (1 | 0)
# export QUINE_MAX_TURNS=0                         # execution budget
# export QUINE_MAX_DEPTH=0                         # recursion limit
# export QUINE_MAX_AGENTS=0                        # process-tree slot limit
# export QUINE_MAX_CONCURRENT=0                    # shared inference concurrency
# export QUINE_FORK_DEFAULT_TIMEOUT_SECONDS=0      # fork/spawn join envelope
# export QUINE_SH_DEFAULT_TIMEOUT_SECONDS=300      # shell envelope
# export QUINE_SH_TIMEOUT_OVERRIDE_ENABLED=1       # shell envelope capability (1 | 0)
# export QUINE_WALL_CLOCK_EXIT_SECONDS=0           # process self-exit deadline
# export QUINE_OUTPUT_TRUNCATE=20480               # tool result truncation
# export QUINE_EMPTY_ASSISTANT_SUCCESS=0           # empty assistant success policy (1 | 0)
# export QUINE_EPHEMERAL_BODY_ENABLED=0            # launch-path body consumption (1 | 0)
# export QUINE_READY_TEXT_AUTO_IDLE=0              # ready-text auto-suspend policy (1 | 0)
# export QUINE_SUPPRESS_INITIAL_BEGIN=0            # synthetic initial-turn policy (1 | 0)

# ── Optional: Runtime Paths, Context Pressure, And Lineage ──
# export QUINE_CONTEXT_WINDOW=128000               # model context budget
# export QUINE_MEMORY_WARN_TOKENS=                 # memory pressure; default derived from QUINE_CONTEXT_WINDOW
# export QUINE_MEMORY_DANGER_TOKENS=               # memory pressure; default derived from QUINE_CONTEXT_WINDOW
# export QUINE_MEMORY_DEATH_TOKENS=0               # memory pressure
# export QUINE_MEMORY_STRATEGY_HINTS=1             # memory pressure prompt (1 | 0)
# export QUINE_DATA_DIR=.quine/                    # runtime root
# export QUINE_RETENTION_DIR=                      # retained owner root
# export QUINE_WORK_DIR=                           # shell cwd default; default derived from QUINE_WORKSPACE
# export QUINE_SHELL=/bin/sh                       # shell binary
# export QUINE_SH_NETWORK=host                     # shell network namespace (host | none)
# export QUINE_SELF_REENTRY_MODE=self              # default fork / exec re-entry mode (self | executable_path)

# ── Example: Anthropic via Claude Code subscription OAuth ─
# Reuses Claude Code credentials when available. If no fresh token can be
# refreshed, Quine starts a browser OAuth flow. You can also export a
# `CLAUDE_CODE_OAUTH_TOKEN` generated by `claude setup-token`.
# export QUINE_PROVIDER=anthropic     # Harness label only
# export QUINE_MODEL_ID=claude-sonnet-4-6
# export QUINE_API_TYPE=anthropic
# export QUINE_API_BASE=https://api.anthropic.com
# export QUINE_API_KEY=claude-oauth

