+copy_tree_contents_best_effort() {
+  local src="$1"
+  local dst="$2"
+  if [[ -d "${src}" ]]; then
+    mkdir -p "${dst}"
+    if ! cp -R "${src}/." "${dst}/"; then
+      printf 'retention warning: partial copy: %s -> %s\n' "${src}" "${dst}" >&2
+      if [[ -n "${META_DIR:-}" && -d "${META_DIR}" ]]; then
+        printf 'partial copy: %s -> %s\n' "${src}" "${dst}" >> "${META_DIR}/retention-copy-warnings.txt"
+      fi
+    fi
+  fi
+}
