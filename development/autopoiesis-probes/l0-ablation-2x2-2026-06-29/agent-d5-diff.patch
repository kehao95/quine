+func TestWorkspaceOverlayPreflightClassifiesSubstrateFailures(t *testing.T) {
+	cases := []struct {
+		name   string
+		driver string
+		err    error
+		wants  []string
+	}{
+		{
+			name:   "kernel bind mount",
+			driver: "kernel",
+			err:    errors.New("overlay mount preflight failed: exit status 1: quine-overlay-preflight:bind-mount: mount --bind failed: permission denied"),
+			wants:  []string{"workspace overlay driver kernel unavailable", "bind-mount policy"},
+		},
+		{
+			name:   "kernel namespace start",
+			driver: "kernel",
+			err:    errors.New("fork/exec /bin/sh: operation not permitted"),
+			wants:  []string{"workspace overlay driver kernel unavailable", "namespace", "starting the probe"},
+		},
+		{
+			name:   "fuse device",
+			driver: "fuse",
+			err:    errFuseOverlayFSDeviceUnavailable,
+			wants:  []string{"workspace overlay driver fuse unavailable", "/dev/fuse", "openable read/write"},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := classifyOverlayPreflightError(tc.driver, tc.err)
+			if err == nil {
+				t.Fatal("expected classified error")
+			}
+			for _, want := range tc.wants {
+				if !strings.Contains(err.Error(), want) {
+					t.Fatalf("classified error = %q, want substring %q", err.Error(), want)
+				}
+			}
+			if tc.err == errFuseOverlayFSDeviceUnavailable && !errors.Is(err, errFuseOverlayFSDeviceUnavailable) {
+				t.Fatalf("classified fuse device error should preserve sentinel, got %v", err)
+			}
+		})
+	}
+}
