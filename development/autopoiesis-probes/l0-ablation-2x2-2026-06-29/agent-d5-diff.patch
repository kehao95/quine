+		return fmt.Errorf("%w: open %s read/write: %v", errFuseOverlayFSDeviceUnavailable, path, err)
+	}
+	if err := f.Close(); err != nil {
+		return fmt.Errorf("%w: close %s: %v", errFuseOverlayFSDeviceUnavailable, path, err)
+	}
+	return nil
+}
