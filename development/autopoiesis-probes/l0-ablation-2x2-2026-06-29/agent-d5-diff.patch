+func classifyOverlayPreflightError(driver string, err error) error {
+	if err == nil {
+		return nil
+	}
+	text := strings.ToLower(err.Error())
+	switch driver {
+	case "", "kernel":
+		switch {
+		case strings.Contains(text, "quine-overlay-preflight:mount-namespace"):
+			return fmt.Errorf("workspace overlay driver kernel unavailable: mount namespace isolation failed; host/container must allow mount propagation changes in a private namespace: %w", err)
+		case strings.Contains(text, "quine-overlay-preflight:bind-mount"):
+			return fmt.Errorf("workspace overlay driver kernel unavailable: bind-mount policy rejected the workspace root self-bind; host/container must allow mount --bind before overlay mount: %w", err)
+		case strings.Contains(text, "quine-overlay-preflight:kernel-mount"):
+			return fmt.Errorf("workspace overlay driver kernel unavailable: kernel overlayfs mount failed; host/container must allow overlayfs lower/upper/work mounts: %w", err)
+		}
+		if hint := namespaceStartFailureHint(os.Getuid(), err); hint != "" {
+			return fmt.Errorf("workspace overlay driver kernel unavailable: %s: %w", hint, err)
+		}
+		return fmt.Errorf("workspace overlay driver kernel unavailable: %w", err)
+	case "fuse":
+		switch {
+		case errors.Is(err, errFuseOverlayFSBinaryUnavailable):
+			return fmt.Errorf("workspace overlay driver fuse unavailable: install fuse-overlayfs or choose QUINE_WORKSPACE_OVERLAY_DRIVER=kernel: %w", err)
+		case errors.Is(err, errFuseOverlayFSUnmountHelperUnavailable):
+			return fmt.Errorf("workspace overlay driver fuse unavailable: install fusermount3 or fusermount so fuse-overlayfs mounts can be cleaned up: %w", err)
+		case errors.Is(err, errFuseOverlayFSDeviceUnavailable):
+			return fmt.Errorf("workspace overlay driver fuse unavailable: /dev/fuse must exist and be openable read/write by this process: %w", err)
+		}
+		if hint := namespaceStartFailureHint(os.Getuid(), err); hint != "" {
+			return fmt.Errorf("workspace overlay driver fuse unavailable: %s: %w", hint, err)
+		}
+		return fmt.Errorf("workspace overlay driver fuse unavailable: fuse-overlayfs feasibility probe failed: %w", err)
+	default:
+		return err
+	}
+}
+
+func namespaceStartFailureHint(uid int, err error) string {
+	text := strings.ToLower(err.Error())
+	if !strings.Contains(text, "operation not permitted") && !strings.Contains(text, "permission denied") {
+		return ""
+	}
+	if uid == 0 {
+		return "mount namespace or CAP_SYS_ADMIN unavailable while starting the probe"
+	}
+	return "user namespace or mount namespace unavailable while starting the probe"
+}
