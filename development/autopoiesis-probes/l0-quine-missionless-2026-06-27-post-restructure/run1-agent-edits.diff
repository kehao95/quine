 # Emit the active Go package set used by substrate validation.
 # Historical evidence trees under */runs/* are repo-retained artifacts, not
 # active substrate packages.
+#
+# NOTE: this is a package ENUMERATOR, not a compile check. It uses `go list -e`
+# so it still emits the package set when a generated build artifact is absent —
+# notably selfsource_bundle_data.go (a Makefile-generated, gitignored embed
+# target that build/test targets create via `make self-source-bundle`). Bare
+# `go list ./...` fails on the missing embed pattern, which would break
+# `make check-control-plane` on a clean checkout. Compilation validity is owned
+# by the build/test targets that generate the bundle, not by this enumerator.
 
 set -euo pipefail
 
 ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
 cd "$ROOT_DIR"
 
-go list ./... | awk '$0 !~ /\/runs\//'
+go list -e ./... | awk '$0 !~ /\/runs\//'
